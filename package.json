{
  "preview": true,
  "icon": "icon5.png",
  "name": "cloud-city-color-theme",
  "displayName": "Cloud City",
  "description": "A neutral, low-contrast, light colour theme for VSCode",
  "publisher": "christiannaths",
  "repository": "https://github.com/christiannaths/cloud-city-color-theme",
  "author": {
    "name": "Christian Naths",
    "email": "christiannaths@gmail.com"
  },
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Cloud City",
        "uiTheme": "vs",
        "path": "./themes/cloud-city-color-theme.json"
      }
    ],
    "grammars": [
      {
        "path": "./syntaxes/javascript-todo-comment-injection.json",
        "scopeName": "todo-comment.injection",
        "injectTo": [
          "source.js"
        ]
      },
      {
        "path": "./syntaxes/dockerfile-section-injection.json",
        "scopeName": "dockerfile.section.injection",
        "injectTo": [
          "source.dockerfile"
        ]
      }
    ]
  },
  "license": "UNLICENSE"
}
